{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book.schema.json",
  "title": "叁仟书屋书目元数据",
  "description": "单本书 books/<id>-<slug>/meta.json 的形状。本仓不收录全文或下载地址，故无 files / download 等字段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "author",
    "category",
    "tags",
    "language",
    "rights",
    "oneSentenceSummary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "description": "四位数字书号，如 0001。"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "目录与 URL 用的短名，小写字母、数字与连字符。"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "中文书名。"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "era"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "作者或托名/编著者。"
        },
        "era": {
          "type": "string",
          "minLength": 1,
          "description": "成书或主要活动时代，自由文本。"
        }
      }
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "一级类目，如 哲学、自然科学、历史与社会、文学、地理艺术。"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "主题标签。"
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "description": "本条元数据所用语言标签，种籽书目为 zh。"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "hostsFullText"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "unverified",
          "description": "公版状态未逐本核验，固定为 unverified。"
        },
        "hostsFullText": {
          "type": "boolean",
          "const": false,
          "description": "本仓不托管全文，固定为 false。"
        }
      }
    },
    "oneSentenceSummary": {
      "type": "string",
      "minLength": 1,
      "description": "一句事实性说明这本书是什么。不要写评分、馆藏数字或宣传语。"
    }
  }
}
